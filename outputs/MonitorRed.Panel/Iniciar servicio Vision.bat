@echo off
rem Controla el servicio Vision registrado en Windows.
rem Accion: Start-Service -Name Vision -ErrorAction Stop
rem Solicita permisos de administrador y espera confirmacion del estado.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -Command "try { $controlProcess = Start-Process -FilePath ($env:SystemRoot + '\System32\WindowsPowerShell\v1.0\powershell.exe') -Verb RunAs -ArgumentList '-NoProfile -EncodedCommand ' -Wait -PassThru; exit $controlProcess.ExitCode } catch { Write-Host ('No se pudo iniciar el control del servicio: ' + $_.Exception.Message); exit 1 }"
if errorlevel 1 pause